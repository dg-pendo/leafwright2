# Auth.js secret used to sign session JWTs. Generate one with `openssl rand -base64 32`.
AUTH_SECRET=

# Password shared by every seeded user.
DEMO_PASSWORD=leafwright-demo

# Optional. When set, the assistant answers with Claude instead of scripted replies.
ANTHROPIC_API_KEY=
# Optional. Workspace to bill when ANTHROPIC_API_KEY is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# Optional. When both are set, data is stored in Upstash Redis instead of process memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. When set, the analytics wrapper sends events; otherwise it no-ops.
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=
# Optional. Collector URL for the wrapper. With a key but no endpoint, events are queued and logged.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Optional. Server-only shared secret for Pendo track events sent from server actions and route
# handlers; without it they are skipped. Never expose it with a NEXT_PUBLIC_ prefix.
PENDO_TRACK_EVENT_SECRET=

# Optional. Protects the nightly archive job route; Vercel Cron sends it as a bearer token.
CRON_SECRET=
